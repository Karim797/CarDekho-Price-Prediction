   "source": [
    "## 11. Feature Engineering\n",
    "\n",
    "We keep one small helper because parsing `name` into manufacturer and model is repeated logic that is\n",
    "much clearer as a function.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "mG6IYPKMlfUe",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 380
    },
    "id": "mG6IYPKMlfUe",
    "outputId": "26929574-11f4-44d6-bd6a-93a168b28095"
   },
   "outputs": [],
   "source": [
    "REFERENCE_YEAR = 2026\n",
    "MULTI_WORD_COMPANIES = {\"Land Rover\", \"Ashok Leyland\"}\n",
    "\n",
    "def extract_company_model(car_name):\n",
    "    if pd.isna(car_name):\n",
    "        return np.nan, np.nan\n",
    "\n",
    "    parts = str(car_name).strip().split()\n",
    "\n",
    "    if len(parts) == 0:\n",
    "        return np.nan, np.nan\n",
    "\n",
    "    first_two = \" \".join(parts[:2]) if len(parts) >= 2 else parts[0]\n",
    "\n",
    "    if first_two in MULTI_WORD_COMPANIES:\n",
    "        company = first_two\n",
    "        model = parts[2] if len(parts) >= 3 else np.nan\n",
    "    else:\n",
    "        company = parts[0]\n",
    "        model = parts[1] if len(parts) >= 2 else np.nan\n",
    "\n",
    "    return company, model\n",
    "\n",
    "company_model = model_df[\"name\"].apply(extract_company_model)\n",
    "\n",
    "model_df[[\"company\", \"model\"]] = pd.DataFrame(\n",
    "    company_model.tolist(),\n",
    "    index=model_df.index,\n",
    ")\n",
    "\n",
    "model_df[\"car_age\"] = REFERENCE_YEAR - model_df[\"year\"]\n",
    "\n",
    "model_df[\"km_per_year\"] = (\n",
    "    model_df[\"km_driven\"]\n",
    "    / model_df[\"car_age\"].replace(0, np.nan)\n",
    ")\n",
    "\n",
    "model_df.drop(columns=[\"name\", \"year\"], inplace=True)\n",
    "\n",
    "display(\n",
    "    model_df[\n",
    "        [\"company\", \"model\", \"car_age\", \"km_driven\", \"km_per_year\", \"selling_price\"]\n",
    "    ].head(10)\n",
    ")\n",
    "\n",
    "print(\"Shape after feature engineering:\", model_df.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "DPasubrYlfUf",
   "metadata": {
    "id": "DPasubrYlfUf"
   },
   "source": [
    "## 12. Train/Test Split\n",
    "\n",
    "The test set is kept untouched until all model and target-strategy decisions are made using training\n",
    "cross-validation.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "pHhRK2VhlfUf",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "pHhRK2VhlfUf",
    "outputId": "3b8e35ba-526a-41d3-89c9-7239adabe5d2"
   },
   "outputs": [],
   "source": [
    "target = \"selling_price\"\n",
    "\n",
    "X = model_df.drop(columns=target)\n",
    "y = model_df[target]\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X,\n",
    "    y,\n",
    "    test_size=0.20,\n",
    "    random_state=42,\n",
    ")\n",
    "\n",
    "print(\"X_train:\", X_train.shape)\n",
    "print(\"X_test :\", X_test.shape)\n",
    "print(\"y_train:\", y_train.shape)\n",
    "print(\"y_test :\", y_test.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "zWCId1zFlfUf",
   "metadata": {
    "id": "zWCId1zFlfUf"
   },
   "source": [
    "## 13. Preprocessing\n",
    "\n",
    "- Categorical: most-frequent imputation → one-hot encoding.\n",
    "- Numerical: standardization → KNN imputation.\n",
    "\n",
    "The scaler is placed before KNN imputation so distance is not dominated by large-scale numerical\n",
    "features.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "QZz_jAyHlfUf",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "QZz_jAyHlfUf",
    "outputId": "1d95a07f-7a54-4a41-f4d8-384b96cf6a7d"
   },
   "outputs": [],
   "source": [
    "categorical_cols = X_train.select_dtypes(\n",
    "    include=[\"object\", \"category\"]\n",
    ").columns.tolist()\n",
    "\n",
    "numerical_cols = X_train.select_dtypes(\n",
    "    include=np.number\n",
    ").columns.tolist()\n",
    "\n",
    "print(\"Categorical columns:\", categorical_cols)\n",
    "print(\"Numerical columns:\", numerical_cols)\n",
    "\n",
    "categorical_pipeline = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "    (\"encoder\", OneHotEncoder(\n",
    "        handle_unknown=\"ignore\",\n",
    "        sparse_output=False,\n",
    "    )),\n",
    "])\n",
    "\n",
    "numerical_pipeline = Pipeline([\n",
    "    (\"scaler\", StandardScaler()),\n",
    "    (\"imputer\", KNNImputer(n_neighbors=5)),\n",
    "])\n",
    "\n",
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        (\"num\", numerical_pipeline, numerical_cols),\n",
    "        (\"cat\", categorical_pipeline, categorical_cols),\n",
    "    ],\n",
    "    remainder=\"drop\",\n",
    "    verbose_feature_names_out=False,\n",
    ")\n",
    "\n",
    "print(\"Preprocessor ready.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "m8UHZ5RKlfUg",
   "metadata": {
    "id": "m8UHZ5RKlfUg"
   },
   "source": [
    "## 14. Baseline Regression Models + Cross-Validation\n",
    "\n",
    "`Dummy Median` is included as a real baseline. A useful ML model should clearly beat this simple\n",
    "strategy.\n",
    "\n",
    "Main model-selection metric: **CV RMSE** (lower is better).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "xADjabJ8lfUg",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 300
    },
    "id": "xADjabJ8lfUg",
    "outputId": "478ecc00-ac97-4b42-c01d-430e80685300"
   },
   "outputs": [],
   "source": [
    "models = {\n",
    "    \"Dummy Median\": DummyRegressor(strategy=\"median\"),\n",
    "    \"Linear Regression\": LinearRegression(),\n",
    "    \"Ridge\": Ridge(),\n",
    "    \"Lasso\": Lasso(max_iter=10_000),\n",
    "    \"Decision Tree\": DecisionTreeRegressor(random_state=42),\n",
    "    \"Random Forest\": RandomForestRegressor(\n",
    "        n_estimators=300,\n",
    "        random_state=42,\n",
    "        n_jobs=1,\n",
    "    ),\n",
    "    \"Gradient Boosting\": GradientBoostingRegressor(random_state=42),\n",
    "}\n",
    "\n",
    "if XGBOOST_AVAILABLE:\n",
    "    models[\"XGBoost\"] = XGBRegressor(\n",
    "        objective=\"reg:squarederror\",\n",
    "        random_state=42,\n",
    "        n_estimators=300,\n",
    "        n_jobs=1,\n",
    "        verbosity=0,\n",
    "    )\n",
    "\n",
    "cv = KFold(\n",
    "    n_splits=5,\n",
    "    shuffle=True,\n",
    "    random_state=42,\n",
    ")\n",
    "\n",
    "scoring = {\n",
    "    \"mae\": \"neg_mean_absolute_error\",\n",
    "    \"rmse\": \"neg_root_mean_squared_error\",\n",
    "    \"r2\": \"r2\",\n",
    "    \"mape\": \"neg_mean_absolute_percentage_error\",\n",
    "}\n",
    "\n",
    "baseline_results = []\n",
    "\n",
    "for model_name, regressor in models.items():\n",
    "    pipeline = Pipeline([\n",
    "        (\"preprocessor\", clone(preprocessor)),\n",
    "        (\"model\", clone(regressor)),\n",
    "    ])\n",
    "\n",
    "    scores = cross_validate(\n",
    "        pipeline,\n",
    "        X_train,\n",
    "        y_train,\n",
    "        cv=cv,\n",
    "        scoring=scoring,\n",
    "        n_jobs=-1,\n",
    "    )\n",
    "\n",
    "    baseline_results.append({\n",
    "        \"Model\": model_name,\n",
    "        \"CV_MAE\": -scores[\"test_mae\"].mean(),\n",
    "        \"CV_RMSE\": -scores[\"test_rmse\"].mean(),\n",
    "        \"CV_R2\": scores[\"test_r2\"].mean(),\n",
    "        \"CV_MAPE_%\": -scores[\"test_mape\"].mean() * 100,\n",
    "        \"CV_RMSE_STD\": scores[\"test_rmse\"].std(),\n",
    "    })\n",
    "\n",
    "baseline_results_df = (\n",
    "    pd.DataFrame(baseline_results)\n",
    "    .sort_values(\"CV_RMSE\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "display(baseline_results_df.round(4))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d80b73d2",
   "metadata": {},
   "source": [
    "### Visual Analysis"
   ]
  },
