    "outputId": "a4ebc0c9-3edd-4525-b83b-62043ba11489"
   },
   "outputs": [],
   "source": [
    "dummy_pipeline = Pipeline([\n",
    "    (\"preprocessor\", clone(preprocessor)),\n",
    "    (\"model\", DummyRegressor(strategy=\"median\")),\n",
    "])\n",
    "\n",
    "dummy_pipeline.fit(X_train, y_train)\n",
