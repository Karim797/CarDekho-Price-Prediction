    "\n",
    "print(\"\\nImprovement over Dummy:\")\n",
    "print(f\"RMSE reduction: {dummy_test_rmse - test_rmse:,.2f}\")\n",
    "print(f\"R² improvement: {test_r2 - dummy_test_r2:.4f}\")"
   ]
  },
