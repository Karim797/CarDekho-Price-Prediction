    "## 10. Cleaning for Modeling\n",
    "\n",
    "- Remove exact duplicates.\n",
    "- Treat `mileage = 0` as invalid and convert it to missing.\n",
    "- Keep other missing rows; imputers inside the pipeline handle them using training data only.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "W1zV8RGIlfUe",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 262
    },
    "id": "W1zV8RGIlfUe",
    "outputId": "0852f661-c864-438f-f038-52a2d4ed5278"
   },
   "outputs": [],
   "source": [
    "model_df = df.copy()\n",
    "\n",
    "rows_before = len(model_df)\n",
    "model_df = model_df.drop_duplicates().reset_index(drop=True)\n",
    "\n",
    "print(\"Rows before duplicate removal:\", rows_before)\n",
    "print(\"Rows after duplicate removal :\", len(model_df))\n",
    "print(\"Duplicates removed           :\", rows_before - len(model_df))\n",
    "\n",
    "zero_mileage_count = (model_df[\"mileage\"] == 0).sum()\n",
    "model_df[\"mileage\"] = model_df[\"mileage\"].replace(0, np.nan)\n",
    "\n",
    "print(\"\\nZero mileage values converted to NaN:\", zero_mileage_count)\n",
    "\n",
    "remaining_missing = model_df.isna().sum()\n",
    "display(remaining_missing[remaining_missing > 0].to_frame(\"missing_count\"))"
   ]
  },
